<!-- Add the studio's real contact channel here when it exists (email, form or booking link). -->
<div class="contact-bottom"><p>The first step is a conversation about the project, so we can scope it.</p></div>
</div></section>
</main>
<footer class="footer shell">
<span>Independent branding studio</span>
<a href="#top">Back to top <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V4m-7 7 7-7 7 7"/></svg></a>
<img class="footer-wordmark reveal" src="/orion-wordmark-large.webp" alt="Orion" width="1800" height="526" loading="lazy" decoding="async">
<small>© 2026 Orion. All rights reserved.</small>
</footer>

<script>
import { animate, inView } from "motion";

const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
const canHover = matchMedia("(hover: hover) and (pointer: fine)").matches;

// Critically damped by default. Bounce is reserved for gestures that carry momentum.
const spring = (duration = 0.6, bounce = 0) => ({ type: "spring" as const, bounce, duration });
const smooth = [0.22, 1, 0.36, 1] as [number, number, number, number];

/* Header material deepens once content scrolls under it */
const header = document.querySelector<HTMLElement>(".header");
const onScroll = () => header?.classList.toggle("is-scrolled", scrollY > 8);
addEventListener("scroll", onScroll, { passive: true });
onScroll();

/* Mobile menu. It opens from the button's corner and can be reversed mid-motion. */
const menuButton = document.querySelector<HTMLButtonElement>(".menu");
const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
let menuOpen = false;
const setMenu = (open: boolean) => {
  if (!menuButton || !mobileMenu) return;
  menuOpen = open;
  menuButton.setAttribute("aria-expanded", String(open));
  menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  if (open) {
    const fresh = mobileMenu.hidden;
    mobileMenu.hidden = false;
    if (reduceMotion) animate(mobileMenu, { opacity: fresh ? [0, 1] : 1 }, { duration: 0.15 });
    else animate(mobileMenu, fresh ? { opacity: [0, 1], scale: [0.96, 1] } : { opacity: 1, scale: 1 }, spring(0.35));
  } else {
    const closing = reduceMotion
      ? animate(mobileMenu, { opacity: 0 }, { duration: 0.12 })
      : animate(mobileMenu, { opacity: 0, scale: 0.96 }, spring(0.25));
    closing.finished.then(() => { if (!menuOpen) mobileMenu.hidden = true; });
  }
};
menuButton?.addEventListener("click", () => setMenu(!menuOpen));
mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
addEventListener("keydown", (event) => {
  if (event.key === "Escape" && menuOpen) { setMenu(false); menuButton?.focus(); }
});
addEventListener("pointerdown", (event) => {
  const target = event.target;
  if (menuOpen && target instanceof Node && !mobileMenu?.contains(target) && !menuButton?.contains(target)) setMenu(false);
});

/* Wayfinding: mark the nav link for the section in view */
const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".nav a")];
const spy = new IntersectionObserver((entries) => {
  for (const entry of entries) {
    const link = navLinks.find((item) => item.hash === "#" + entry.target.id);
    if (!link) continue;
    if (entry.isIntersecting) link.setAttribute("aria-current", "true");
    else link.removeAttribute("aria-current");
  }
}, { rootMargin: "-45% 0px -50% 0px" });
navLinks.forEach((link) => {
  const section = document.querySelector(link.hash);
  if (section) spy.observe(section);
});

/* Hero entrance */
const enter = (element: Element | null, delay = 0) => {
  if (!element) return;
  if (reduceMotion) {
    animate(element, { opacity: [0, 1] }, { duration: 0.4, delay });
    return;
  }
  animate(element, { opacity: [0, 1], y: [40, 0] }, { ...spring(0.9), delay });
  animate(element, { filter: ["blur(10px)", "blur(0px)"] }, { duration: 0.7, delay, ease: smooth });
};
enter(document.querySelector(".hero h1"));
enter(document.querySelector(".hero-aside"), 0.15);
enter(document.querySelector(".hero-banner"), 0.25);

/* Slow, eased scroll response for the hero artwork.
   The target follows the page immediately; the image catches up gradually. */
const heroBanner = document.querySelector<HTMLElement>(".hero-banner");
const heroImage = heroBanner?.querySelector<HTMLImageElement>("img");
if (heroBanner && heroImage && !reduceMotion) {
  let targetScale = 1.015;
  let targetY = 0;
  let currentScale = targetScale;
  let currentY = targetY;
  let frame = 0;

  const updateHeroTarget = () => {
    const bounds = heroBanner.getBoundingClientRect();
    const progress = Math.min(1, Math.max(0, (innerHeight - bounds.top) / (innerHeight + bounds.height)));
    targetScale = 1.015 + progress * 0.075;
    targetY = -progress * 32;
    if (!frame) frame = requestAnimationFrame(easeHeroArtwork);
  };

  const easeHeroArtwork = () => {
    currentScale += (targetScale - currentScale) * 0.035;
    currentY += (targetY - currentY) * 0.035;
    heroImage!.style.transform = `translate3d(0, ${currentY}px, 0) scale(${currentScale})`;
    if (Math.abs(targetScale - currentScale) > 0.0005 || Math.abs(targetY - currentY) > 0.05) {
      frame = requestAnimationFrame(easeHeroArtwork);
    } else {
      currentScale = targetScale;
      currentY = targetY;
      frame = 0;
    }
  };

  heroImage.style.transformOrigin = "center center";
  heroImage.style.willChange = "transform";
  addEventListener("scroll", updateHeroTarget, { passive: true });
  addEventListener("resize", updateHeroTarget);
  updateHeroTarget();
}

/* Scroll reveals, staggered across siblings */
inView(".reveal", (element) => {
  if (reduceMotion) {
    animate(element, { opacity: [0, 1] }, { duration: 0.3 });
    return;
  }
  const siblings = [...(element.parentElement?.children ?? [])].filter((child) => child.classList.contains("reveal"));
  const delay = Math.max(0, siblings.indexOf(element)) * 0.08;
  animate(element, { opacity: [0, 1], y: [28, 0] }, { ...spring(0.8), delay });
}, { margin: "0px 0px -10% 0px" });

/* Cursor-following highlight on cards */
if (canHover) {
  document.querySelectorAll<HTMLElement>(".principle, .price-card").forEach((card) => {
    card.addEventListener("pointermove", (event) => {
      const box = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${event.clientX - box.left}px`);
      card.style.setProperty("--my", `${event.clientY - box.top}px`);
    });
  });
}
</script>
<script is:inline type="module">
  /* Smooth the page's actual wheel scrolling, not just the hero artwork. */
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    import("https://esm.sh/lenis@1.3.11").then(({ default: Lenis }) => {
      const lenis = new Lenis({
        lerp: 0.045,
        wheelMultiplier: 0.5,
        smoothWheel: true,
        syncTouch: false
      });
      const raf = (time) => {
        lenis.raf(time);
        requestAnimationFrame(raf);
      };
      requestAnimationFrame(raf);
    });
  }
</script>
</body>
</html>
