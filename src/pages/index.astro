---
import "../styles/global.css";
const packages=[{id:"identity",name:"Brand identity",price:"From €850",description:"A clear visual system built around what makes your business distinct.",items:["Logo suite and brand marks","Colour and typography system","Core brand guidelines"]},{id:"digital",name:"Digital design",price:"From €1,200",description:"A considered website direction that gives your brand a strong digital home.",items:["Website art direction","Responsive page design","Developer-ready design files"]},{id:"complete",name:"Complete brand",price:"Custom quote",description:"A joined-up identity and digital presence, planned around your goals.",items:["Brand strategy and identity","Digital design direction","A tailored project scope"]}];
const projects=[{name:"Identity in motion",type:"Brand identity"},{name:"Form follows feeling",type:"Digital direction"},{name:"A sharper point of view",type:"Campaign identity"}];
---
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#f5f5f2"><meta name="description" content="Orion is an independent creative studio building clear brand identities and thoughtful digital experiences."><title>Orion® — Independent creative studio</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"></head>
<body>
<header class="header" id="top"><a class="logo" href="#top">ORION<span>®</span></a><nav class="nav" aria-label="Main navigation"><a href="#work">Work</a><a href="#pricing">Pricing</a><a href="#about">About</a></nav><div class="actions"><button class="theme" aria-label="Switch colour theme" aria-pressed="false">◐</button><a class="nav-cta" href="#contact">Start a project ↗</a><button class="menu" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu"><span></span><span></span></button></div><nav class="mobile-menu" id="mobile-menu" hidden><a href="#work">Work</a><a href="#pricing">Pricing</a><a href="#about">About</a><a href="#contact">Contact ↗</a></nav></header>
<main>
<section class="hero shell"><p class="kicker"><i></i> Independent creative studio <span>·</span> Working worldwide</p><div class="hero-copy"><h1>Make your<br><span>mark.</span></h1><div class="hero-aside"><p>We build thoughtful identities and digital experiences for businesses ready to move forward.</p><a class="underlink" href="#work">Explore our work ↓</a></div></div>
<div class="hero-stage" data-stage><div class="stage-label"><span>ORION® / CREATIVE PRACTICE</span><span>EST. FOR WHAT'S NEXT</span></div><div class="composition" data-art><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="sphere sphere-dark"></div><div class="sphere sphere-light"></div><div class="hero-mark">O<span>R</span>ION</div><small>IDENTITY / 001<br>BUILT TO BE DISTINCT.</small></div><div class="stage-label bottom"><span>STRATEGY / IDENTITY / DIGITAL</span><span>SCROLL TO EXPLORE ↓</span></div></div><div class="hero-foot"><span>GOOD IDEAS DESERVE<br>A CLEAR IDENTITY.</span><span>01 — 06</span></div></section>
<section class="intro shell reveal"><p class="eyebrow">A CREATIVE PARTNER FOR WHAT'S NEXT</p><h2>Good brands make<br>themselves <span>understood.</span></h2><p>We bring clarity to how your business looks, speaks and shows up. Thoughtful work, made to last.</p></section>
<section class="work shell" id="work"><div class="section-head reveal"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Made with<br>intent.</h2></div><p>A look at the kind of thinking<br>we bring to every project.</p></div><div class="projects">{projects.map((project,index)=><article class="project reveal"><a href="#contact"><div class:list={["project-art","art-"+(index+1)]}><small>ORION® / 0{index+1}</small>{index===0?<b>O<span>.</span></b>:index===1?<strong>FORM<br><i>AND</i><br>FUNCTION</strong>:<strong class="shift">SHIFT</strong>}<small class="art-bottom">VISUAL STUDY — 0{index+1}</small></div><div class="project-meta"><div><h3>{project.name}</h3><p>{project.type}</p></div><span>↗</span></div></a></article>)}</div><p class="note">Concept studies shown. Approved client projects will replace these visual studies.</p></section>
<section class="pricing" id="pricing"><div class="shell"><div class="section-head reveal"><div><p class="eyebrow">02 / PRICING</p><h2>Clear scope.<br><span>Good work.</span></h2></div><p>Choose a starting point.<br>We'll shape the details together.</p></div><div class="pricing-grid reveal"><div class="package-tabs" role="tablist" aria-label="Choose a project package">{packages.map((item,index)=><button class:list={["package-tab",index===0?"active":""]} role="tab" aria-selected={index===0} aria-controls="package-panel" data-id={item.id}><span>0{index+1}</span>{item.name}<b>↗</b></button>)}</div><div class="package-panel" id="package-panel" role="tabpanel"><p class="eyebrow" id="package-number">PACKAGE 01</p><h3 id="package-name">{packages[0].name}</h3><p id="package-description">{packages[0].description}</p><div class="price" id="package-price">{packages[0].price}</div><ul id="package-items">{packages[0].items.map(item=><li>{item}</li>)}</ul><a class="button" href="#contact">Enquire about this ↗</a><small>Final pricing depends on scope, timeline and project needs.</small></div></div></div></section>
<section class="about shell" id="about"><div class="about-top reveal"><p class="eyebrow">03 / ABOUT ORION</p><span>INDEPENDENT BY DESIGN.</span></div><div class="about-grid reveal"><h2>Small studio.<br><span>Big-picture</span><br>thinking.</h2><div><p>Orion is an independent creative studio for businesses with somewhere to go.</p><p>We focus on the details that make a brand recognisable, useful and ready for its next chapter. No noise. Just considered design and clear decisions.</p><a class="underlink" href="#contact">A little about your project ↗</a></div></div></section>
<section class="contact" id="contact"><div class="shell reveal"><p class="eyebrow">04 / THE NEXT STEP</p><h2>Have something<br>in <span>mind?</span></h2><div class="contact-bottom"><p>Tell us what you're building.<br>We'll take it from there.</p><a href="mailto:hello@orionstudio.design">Start a conversation ↗</a></div></div></section>
</main><footer class="footer shell"><a class="logo" href="#top">ORION<span>®</span></a><span>Independent creative studio. Working worldwide.</span><a href="#top">Back to top ↑</a><small>© 2026 ORION. ALL RIGHTS RESERVED.</small></footer>
<script>
import { animate, inView } from "motion";
const theme=document.querySelector(".theme");theme?.addEventListener("click",()=>{const dark=document.documentElement.dataset.theme!=="dark";document.documentElement.dataset.theme=dark?"dark":"light";theme.setAttribute("aria-pressed",String(dark));theme.setAttribute("aria-label",dark?"Switch to light theme":"Switch to dark theme");});
const menu=document.querySelector(".menu"),mobile=document.querySelector("#mobile-menu");menu?.addEventListener("click",()=>{const open=menu.getAttribute("aria-expanded")==="true";menu.setAttribute("aria-expanded",String(!open));mobile.hidden=open;menu.setAttribute("aria-label",open?"Open menu":"Close menu");});mobile?.querySelectorAll("a").forEach(link=>link.addEventListener("click",()=>{mobile.hidden=true;menu?.setAttribute("aria-expanded","false");}));
const data=[{id:"identity",name:"Brand identity",price:"From €850",description:"A clear visual system built around what makes your business distinct.",items:["Logo suite and brand marks","Colour and typography system","Core brand guidelines"]},{id:"digital",name:"Digital design",price:"From €1,200",description:"A considered website direction that gives your brand a strong digital home.",items:["Website art direction","Responsive page design","Developer-ready design files"]},{id:"complete",name:"Complete brand",price:"Custom quote",description:"A joined-up identity and digital presence, planned around your goals.",items:["Brand strategy and identity","Digital design direction","A tailored project scope"]}];
const tabs=[...document.querySelectorAll(".package-tab")];function choose(id){const i=data.findIndex(item=>item.id===id),item=data[i];if(!item)return;tabs.forEach((tab,n)=>{tab.classList.toggle("active",n===i);tab.setAttribute("aria-selected",String(n===i));});document.querySelector("#package-number").textContent="PACKAGE 0"+(i+1);document.querySelector("#package-name").textContent=item.name;document.querySelector("#package-description").textContent=item.description;document.querySelector("#package-price").textContent=item.price;const list=document.querySelector("#package-items");list.replaceChildren(...item.items.map(text=>{const li=document.createElement("li");li.textContent=text;return li;}));}tabs.forEach(tab=>tab.addEventListener("click",()=>choose(tab.dataset.id)));
if(!matchMedia("(prefers-reduced-motion: reduce)").matches){inView(".reveal",el=>{animate(el,{opacity:[0,1],y:[26,0]},{duration:.7,ease:[.22,1,.36,1]});});const stage=document.querySelector("[data-stage]"),art=document.querySelector("[data-art]");let raf=0;const zoom=()=>{if(!stage||!art||raf)return;raf=requestAnimationFrame(()=>{raf=0;const rect=stage.getBoundingClientRect(),p=Math.max(0,Math.min(1,(innerHeight-rect.top)/(innerHeight+rect.height*.35)));art.style.transform="scale("+(0.82+p*.28)+") translateY("+(1-p)*24+"px)";});};addEventListener("scroll",zoom,{passive:true});addEventListener("resize",zoom);zoom();}
</script></body></html>