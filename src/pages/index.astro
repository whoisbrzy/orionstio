---
import "../styles/global.css";
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#000000">
<meta name="color-scheme" content="dark">
<meta name="description" content="Orion is an independent branding studio. We design brand strategy, identity and digital work, and we quote each project after we scope it.">
<title>Orion, independent branding studio</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23000'/%3E%3Ccircle cx='16' cy='16' r='13.5' fill='none' stroke='%23fff' stroke-width='1'/%3E%3Ccircle cx='16' cy='16' r='5' fill='%23fff'/%3E%3C/svg%3E">
<script is:inline>document.documentElement.classList.add("js");</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..700&display=swap" rel="stylesheet">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="header" id="top">
<a class="logo" href="#top" aria-label="Orion home">ORION<span>®</span></a>
<nav class="nav" aria-label="Main navigation"><a href="#approach">Approach</a><a href="#pricing">Pricing</a><a href="#about">About</a></nav>
<div class="actions">
<a class="nav-cta" href="#contact">Start a project <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11"/></svg></a>
<button class="icon-button menu" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu"><span></span><span></span></button>
</div>
<nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" hidden><a href="#approach">Approach</a><a href="#pricing">Pricing</a><a href="#about">About</a><a href="#contact">Start a project <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11"/></svg></a></nav>
</header>
<main id="main">
<section class="hero shell">
<div class="hero-copy">
<h1>Brand<br><span>identity.</span></h1>
<div class="hero-aside">
<p>We design brand strategy, identity and digital work for businesses that have something to say.</p>
<div class="hero-actions">
<a class="button" href="#contact">Start a project <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11"/></svg></a>
<a class="underlink" href="#approach">How we work <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16m-7-7 7 7 7-7"/></svg></a>
</div>
</div>
</div>
<div class="hero-stage" data-stage>
<div class="stage-label"><span>Orion®</span><span>Branding studio</span></div>
<div class="composition" data-art aria-hidden="true">
<div class="depth" data-depth="10"><div class="orbit orbit-a"><i></i></div><div class="orbit orbit-b"><i></i></div><div class="orbit orbit-c"><i></i></div></div>

<div class="depth depth-front" data-depth="26"><div class="sphere sphere-dark"></div><div class="sphere sphere-light"></div></div>
</div>
<div class="stage-label bottom"><span>Strategy, identity, digital</span><span>Scroll <b>↓</b></span></div>
</div>
</section>

<section class="intro shell reveal" id="approach">
<h2 class="section-title">The approach</h2>
<h3 class="display">Start with what<br>you need to <span>say.</span></h3>
<p>A brand should tell people who you are and what you do. We remove any design decision that doesn't help with that.</p>
</section>

<section class="approach shell">
<div class="section-head reveal"><div><h2 class="section-title">How we decide</h2><h3 class="display">Three principles<br><span>for every project.</span></h3></div></div>
<div class="principles">
<article class="principle reveal"><span class="principle-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="15"/><path d="M24 2v8m0 28v8M2 24h8m28 0h8M24 16v8l6 4"/></svg></span><h3>Purpose first</h3><p>We start with what the business needs to communicate. The strategy decides the design.</p></article>
<article class="principle reveal"><span class="principle-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 36 19 12l9 17 5-9 8 16H7Z"/><circle cx="34" cy="12" r="4"/></svg></span><h3>Distinct, not trendy</h3><p>We build a visual language that belongs to your business instead of following trends.</p></article>
<article class="principle reveal"><span class="principle-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="7" y="7" width="34" height="34" rx="2"/><path d="M7 19h34M19 19v22m10-22v22"/></svg></span><h3>Made to work</h3><p>The identity has to look consistent everywhere people meet it.</p></article>
</div>
</section>

<section class="pricing" id="pricing"><div class="shell">
<div class="section-head reveal"><div><h2 class="section-title">Pricing</h2><h3 class="display">Scope comes<br><span>before the quote.</span></h3></div><p>There are no fixed packages. We quote each project after we scope it.</p></div>
<div class="pricing-lead reveal"><span class="pricing-symbol">€</span><p>Price depends on how much work the project needs. We can't give an honest number until we've defined it.</p></div>
<div class="price-cards">
<article class="price-card reveal"><span class="price-step">Step 1</span><h3>Scope</h3><p>We define the challenge, goals and work required.</p></article>
<article class="price-card reveal"><span class="price-step">Step 2</span><h3>Proposal</h3><p>You receive a scope, a timeline and a quote.</p></article>
<article class="price-card reveal"><span class="price-step">Step 3</span><h3>Start work</h3><p>Work begins once you agree on the direction and the price.</p></article>
</div>
<p class="pricing-note">You get a quote before any work begins.</p>
</div></section>

<section class="about shell" id="about">
<div class="about-top reveal"><h2 class="section-title">About Orion</h2></div>
<div class="about-grid reveal">
<h3 class="display">An independent<br><span>branding studio.</span></h3>
<div>
<p>Orion helps businesses build a clear, distinctive brand.</p>
<p>Strategy, identity and digital work happen in the same studio, so the decisions stay consistent from the first idea to the final detail.</p>
</div>
</div>
</section>

<section class="contact" id="contact"><div class="shell reveal">
<h2 class="section-title">Start a project</h2>
<h3 class="display">Tell us<br>what you're<br><span>building.</span></h3>
<!-- Add the studio's real contact channel here when it exists (email, form or booking link). -->
<div class="contact-bottom"><p>The first step is a conversation about the project, so we can scope it.</p></div>
</div></section>
</main>
<footer class="footer shell"><a class="logo" href="#top">ORION<span>®</span></a><span>Independent branding studio</span><a href="#top">Back to top <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V4m-7 7 7-7 7 7"/></svg></a><small>© 2026 Orion. All rights reserved.</small></footer>

<script>
import { animate, inView, scroll } from "motion";

const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
const canHover = matchMedia("(hover: hover) and (pointer: fine)").matches;

// Critically damped by default. Bounce is reserved for gestures that carry momentum.
const spring = (duration = 0.6, bounce = 0) => ({ type: "spring" as const, bounce, duration });
const smooth = [0.22, 1, 0.36, 1] as [number, number, number, number];

/* Header material deepens once content scrolls under it */
const header = document.querySelector<HTMLElement>(".header");
const onScroll = () => header?.classList.toggle("is-scrolled", scrollY > 8);
addEventListener("scroll", onScroll, { passive: true });
onScroll();

/* Mobile menu. It opens from the button's corner and can be reversed mid-motion. */
const menuButton = document.querySelector<HTMLButtonElement>(".menu");
const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
let menuOpen = false;
const setMenu = (open: boolean) => {
  if (!menuButton || !mobileMenu) return;
  menuOpen = open;
  menuButton.setAttribute("aria-expanded", String(open));
  menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  if (open) {
    const fresh = mobileMenu.hidden;
    mobileMenu.hidden = false;
    if (reduceMotion) animate(mobileMenu, { opacity: fresh ? [0, 1] : 1 }, { duration: 0.15 });
    else animate(mobileMenu, fresh ? { opacity: [0, 1], scale: [0.96, 1] } : { opacity: 1, scale: 1 }, spring(0.35));
  } else {
    const closing = reduceMotion
      ? animate(mobileMenu, { opacity: 0 }, { duration: 0.12 })
      : animate(mobileMenu, { opacity: 0, scale: 0.96 }, spring(0.25));
    closing.finished.then(() => { if (!menuOpen) mobileMenu.hidden = true; });
  }
};
menuButton?.addEventListener("click", () => setMenu(!menuOpen));
mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
addEventListener("keydown", (event) => {
  if (event.key === "Escape" && menuOpen) { setMenu(false); menuButton?.focus(); }
});
addEventListener("pointerdown", (event) => {
  const target = event.target;
  if (menuOpen && target instanceof Node && !mobileMenu?.contains(target) && !menuButton?.contains(target)) setMenu(false);
});

/* Wayfinding: mark the nav link for the section in view */
const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".nav a")];
const spy = new IntersectionObserver((entries) => {
  for (const entry of entries) {
    const link = navLinks.find((item) => item.hash === "#" + entry.target.id);
    if (!link) continue;
    if (entry.isIntersecting) link.setAttribute("aria-current", "true");
    else link.removeAttribute("aria-current");
  }
}, { rootMargin: "-45% 0px -50% 0px" });
navLinks.forEach((link) => {
  const section = document.querySelector(link.hash);
  if (section) spy.observe(section);
});

/* Hero entrance */
const enter = (element: Element | null, delay = 0) => {
  if (!element) return;
  if (reduceMotion) {
    animate(element, { opacity: [0, 1] }, { duration: 0.4, delay });
    return;
  }
  animate(element, { opacity: [0, 1], y: [40, 0] }, { ...spring(0.9), delay });
  animate(element, { filter: ["blur(10px)", "blur(0px)"] }, { duration: 0.7, delay, ease: smooth });
};
enter(document.querySelector(".hero h1"));
enter(document.querySelector(".hero-aside"), 0.15);
enter(document.querySelector(".hero-stage"), 0.25);

/* Scroll reveals, staggered across siblings */
inView(".reveal", (element) => {
  if (reduceMotion) {
    animate(element, { opacity: [0, 1] }, { duration: 0.3 });
    return;
  }
  const siblings = [...(element.parentElement?.children ?? [])].filter((child) => child.classList.contains("reveal"));
  const delay = Math.max(0, siblings.indexOf(element)) * 0.08;
  animate(element, { opacity: [0, 1], y: [28, 0] }, { ...spring(0.8), delay });
}, { margin: "0px 0px -10% 0px" });

/* Hero artwork */
const heroStage = document.querySelector<HTMLElement>("[data-stage]");
const art = document.querySelector<HTMLElement>("[data-art]");
if (heroStage && art && !reduceMotion) {
  scroll((progress: number) => {
    const scale = 0.94 + progress * 0.12;
    art.style.transform = `scale(${scale.toFixed(4)}) translateY(${((1 - progress) * 12).toFixed(2)}px)`;
  }, { target: heroStage, offset: ["start end", "end start"] });

  // Slow loops (about 0.1 Hz or less) so nothing oscillates near 0.2 Hz.
  animate(".sphere-dark", { y: [-12, 12], rotate: [0, 12] }, { duration: 9, repeat: Infinity, repeatType: "mirror", ease: "easeInOut" });
  animate(".sphere-light", { y: [10, -10], x: [-6, 6] }, { duration: 11, repeat: Infinity, repeatType: "mirror", ease: "easeInOut" });
  animate(".orbit-a", { rotate: [0, 360] }, { duration: 60, repeat: Infinity, ease: "linear" });
  animate(".orbit-b", { rotate: [0, -360] }, { duration: 80, repeat: Infinity, ease: "linear" });
  animate(".orbit-c", { rotate: [0, 360] }, { duration: 100, repeat: Infinity, ease: "linear" });

  // Pointer parallax. Each move re-targets the spring from its current value and velocity.
  if (canHover) {
    const layers = [...document.querySelectorAll<HTMLElement>("[data-depth]")];
    heroStage.addEventListener("pointermove", (event) => {
      const box = heroStage.getBoundingClientRect();
      const nx = ((event.clientX - box.left) / box.width - 0.5) * 2;
      const ny = ((event.clientY - box.top) / box.height - 0.5) * 2;
      for (const layer of layers) {
        const depth = Number(layer.dataset.depth);
        animate(layer, { x: -nx * depth, y: -ny * depth }, spring(0.7));
      }
    });
    heroStage.addEventListener("pointerleave", () => {
      for (const layer of layers) animate(layer, { x: 0, y: 0 }, spring(0.8));
    });
  }
}

/* Cursor-following highlight on cards */
if (canHover) {
  document.querySelectorAll<HTMLElement>(".principle, .price-card").forEach((card) => {
    card.addEventListener("pointermove", (event) => {
      const box = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${event.clientX - box.left}px`);
      card.style.setProperty("--my", `${event.clientY - box.top}px`);
    });
  });
}
</script>
</body>
</html>
