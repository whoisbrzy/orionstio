---
import "../../styles/global.css";
import "../../styles/admin.css";
import { readSite } from "../../lib/store";
const site = await readSite();
const name = Astro.locals.admin;
const initial = JSON.stringify(site.projects).replace(/</g, "\\u003c");
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#000000">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex, nofollow">
<title>Admin, Orion</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..700&display=swap" rel="stylesheet">
</head>
<body>
<div class="admin"><div class="admin-wrap">
<div class="admin-top">
<img src="/orion-wordmark.webp" alt="Orion" width="480" height="140">
<form method="post" action="/api/auth/logout"><button class="ghost" type="submit">Sign out</button></form>
</div>
<div><h1>Admin</h1><p class="admin-sub">Signed in as {name}. <a href="/" target="_blank" rel="noopener" style="text-decoration:underline">View site</a></p></div>

<form id="site-form" class="admin-wrap" style="gap:1.25rem" novalidate>
<section class="panel" aria-labelledby="maint-h">
<div style="display:flex;justify-content:space-between;align-items:center;gap:1rem"><h2 id="maint-h">Maintenance mode</h2><span class="status-badge" id="maint-badge" data-on={String(site.maintenance.enabled)}>{site.maintenance.enabled ? "Site is down" : "Site is live"}</span></div>
<label class="switch"><div><strong>Put the site in maintenance mode</strong><span>Visitors see a "back soon" page. You still see the real site while signed in.</span></div><input type="checkbox" id="maint-enabled" checked={site.maintenance.enabled}></label>
<div class="field"><label for="maint-message">Message visitors see</label><textarea id="maint-message" maxlength="300" style="min-height:5rem">{site.maintenance.message}</textarea></div>
</section>

<section class="panel" aria-labelledby="ann-h">
<h2 id="ann-h">Announcement banner</h2>
<label class="switch"><div><strong>Show a banner at the top of the site</strong><span>A short message in a white bar above the header.</span></div><input type="checkbox" id="ann-enabled" checked={site.announcement.enabled}></label>
<div class="field"><label for="ann-text">Message</label><input type="text" id="ann-text" maxlength="160" value={site.announcement.text} placeholder="We are open for new projects."></div>
<div class="row">
<div class="field"><label for="ann-link-label">Link text (optional)</label><input type="text" id="ann-link-label" maxlength="30" value={site.announcement.linkLabel} placeholder="See our work"></div>
<div class="field"><label for="ann-link-url">Link address (optional)</label><input type="text" id="ann-link-url" maxlength="500" value={site.announcement.linkUrl} placeholder="/work or https://…"></div>
</div>
</section>

{site.packs.map((pack) => (
<section class="panel" data-pack={pack.id} aria-labelledby={`h-${pack.id}`}>
<h2 id={`h-${pack.id}`}>{pack.name} pack</h2>
<div class="field"><label for={`${pack.id}-name`}>Name</label><input type="text" id={`${pack.id}-name`} data-field="name" value={pack.name} maxlength="40" required></div>
<div class="row">
<div class="field"><label for={`${pack.id}-usd`}>Price in dollars</label><input type="number" id={`${pack.id}-usd`} data-field="usd" value={pack.usd} min="0" step="0.01" inputmode="decimal" required></div>
<div class="field"><label for={`${pack.id}-robux`}>Price in Robux</label><input type="number" id={`${pack.id}-robux`} data-field="robux" value={pack.robux} min="0" step="1" inputmode="numeric" required></div>
</div>
<div class="field"><label for={`${pack.id}-includes`}>What it includes</label><textarea id={`${pack.id}-includes`} data-field="includes">{pack.includes.join("\n")}</textarea><p class="hint">One item per line. Up to 12 items.</p></div>
</section>
))}

<section class="panel" aria-labelledby="copy-h">
<h2 id="copy-h">Page text</h2>
<p class="hint">Leave a box empty to go back to the original text. Up to 400 characters each.</p>
<div class="field"><label for="copy-hero">Hero, next to the banner</label><textarea id="copy-hero" data-copy="hero" maxlength="400" style="min-height:5rem">{site.copy.hero}</textarea></div>
<div class="field"><label for="copy-intro">The approach</label><textarea id="copy-intro" data-copy="intro" maxlength="400" style="min-height:5rem">{site.copy.intro}</textarea></div>
<div class="field"><label for="copy-about1">About, first paragraph</label><textarea id="copy-about1" data-copy="about1" maxlength="400" style="min-height:5rem">{site.copy.about1}</textarea></div>
<div class="field"><label for="copy-about2">About, second paragraph</label><textarea id="copy-about2" data-copy="about2" maxlength="400" style="min-height:5rem">{site.copy.about2}</textarea></div>
<div class="field"><label for="copy-contact">Start a project</label><textarea id="copy-contact" data-copy="contact" maxlength="400" style="min-height:5rem">{site.copy.contact}</textarea></div>
</section>

<section class="panel" aria-labelledby="contact-h">
<h2 id="contact-h">Contact button</h2>
<p class="hint">Shown in the Start a project section. Leave the address empty to hide the button.</p>
<div class="row">
<div class="field"><label for="contact-label">Button text</label><input type="text" id="contact-label" maxlength="40" value={site.contact.label}></div>
<div class="field"><label for="contact-url">Address</label><input type="text" id="contact-url" maxlength="500" value={site.contact.url} placeholder="https://discord.gg/… or mailto:hello@…"></div>
</div>
</section>

<section class="panel" aria-labelledby="proj-h">
<div style="display:flex;justify-content:space-between;align-items:center;gap:1rem"><h2 id="proj-h">Past work</h2><button class="ghost" type="button" id="add-project">Add project</button></div>
<p class="hint">Shown on the Work page, and the first four on the home page. Up to 24 projects. Images are resized in your browser before upload.</p>
<div id="projects" class="projects"></div>
<p class="hint" id="projects-empty" hidden>No projects yet. Click Add project to start.</p>
</section>

<template id="project-template">
<article class="project">
<div class="project-head"><strong class="project-title">New project</strong>
<div class="project-actions"><button type="button" class="ghost" data-action="up" aria-label="Move up">Up</button><button type="button" class="ghost" data-action="down" aria-label="Move down">Down</button><button type="button" class="ghost danger" data-action="remove">Remove</button></div></div>
<div class="row">
<div class="field"><label>Name</label><input type="text" data-p="name" maxlength="60"></div>
<div class="field"><label>Service</label><input type="text" data-p="service" maxlength="60" placeholder="Brand identity"></div>
</div>
<div class="row">
<div class="field"><label>Year</label><input type="number" data-p="year" min="1990" max="2100" step="1" inputmode="numeric"></div>
<div class="field"><span class="label">Image</span><div class="image-row"><img class="thumb" alt="" hidden><label class="ghost file">Upload image<input type="file" accept="image/png,image/jpeg,image/webp" data-p="file" hidden></label><button type="button" class="ghost" data-action="clear-image" hidden>Remove image</button></div></div>
</div>
<div class="field"><label>Summary</label><textarea data-p="summary" maxlength="300" style="min-height:4.5rem"></textarea></div>
</article>
</template>

<div class="save-bar"><p id="status" role="status" aria-live="polite">Changes go live as soon as you save.</p><button class="button" id="save" type="submit">Save changes</button></div>
</form>
</div></div>
<script type="application/json" id="initial-projects" is:inline set:html={initial}></script>

<script>
const form = document.querySelector<HTMLFormElement>("#site-form")!;
const status = document.querySelector<HTMLElement>("#status")!;
const save = document.querySelector<HTMLButtonElement>("#save")!;
const badge = document.querySelector<HTMLElement>("#maint-badge")!;
const enabled = document.querySelector<HTMLInputElement>("#maint-enabled")!;
const message = document.querySelector<HTMLTextAreaElement>("#maint-message")!;
const list = document.querySelector<HTMLElement>("#projects")!;
const emptyNote = document.querySelector<HTMLElement>("#projects-empty")!;
const template = document.querySelector<HTMLTemplateElement>("#project-template")!;
const value = (id: string) => document.querySelector<HTMLInputElement | HTMLTextAreaElement>(id)!.value;
const checked = (id: string) => document.querySelector<HTMLInputElement>(id)!.checked;

let uploads = 0;
const say = (text: string, kind = "") => { status.textContent = text; status.dataset.kind = kind; };
const field = (pack: Element, name: string) => pack.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-field=${name}]`)!.value;

/* Projects. Values go in through .value and .src, never as HTML, so text cannot become markup. */
interface ProjectData { id: string; name: string; service: string; year: number | string; summary: string; image: string }
const input = (row: HTMLElement, name: string) => row.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-p=${name}]`)!;

function showImage(row: HTMLElement) {
  const thumb = row.querySelector<HTMLImageElement>(".thumb")!;
  const clear = row.querySelector<HTMLButtonElement>('[data-action=clear-image]')!;
  const url = row.dataset.image ?? "";
  thumb.hidden = !url;
  clear.hidden = !url;
  if (url) thumb.src = url; else thumb.removeAttribute("src");
}

function refresh() {
  const rows = [...list.children] as HTMLElement[];
  rows.forEach((row, i) => {
    row.querySelector<HTMLElement>(".project-title")!.textContent = `${i + 1}. ${input(row, "name").value || "New project"}`;
    row.querySelector<HTMLButtonElement>('[data-action=up]')!.disabled = i === 0;
    row.querySelector<HTMLButtonElement>('[data-action=down]')!.disabled = i === rows.length - 1;
  });
  emptyNote.hidden = rows.length > 0;
}

function addProject(p?: Partial<ProjectData>) {
  const row = (template.content.firstElementChild!.cloneNode(true)) as HTMLElement;
  row.dataset.id = p?.id ?? "p" + crypto.randomUUID().replace(/-/g, "").slice(0, 12);
  row.dataset.image = p?.image ?? "";
  input(row, "name").value = p?.name ?? "";
  input(row, "service").value = p?.service ?? "";
  input(row, "year").value = String(p?.year ?? new Date().getFullYear());
  input(row, "summary").value = p?.summary ?? "";
  // Give each label a real connection to its control.
  const uid = row.dataset.id!;
  row.querySelectorAll<HTMLElement>(".field").forEach((f, i) => {
    const control = f.querySelector<HTMLElement>("[data-p]:not([data-p=file])");
    const label = f.querySelector("label");
    if (control && label) { control.id = `${uid}-${i}`; label.setAttribute("for", control.id); }
  });
  list.append(row);
  showImage(row);
  refresh();
  return row;
}

/* Shrink and convert in the browser so uploads stay well under the 4 MB limit. */
async function prepare(file: File): Promise<Blob> {
  const bitmap = await createImageBitmap(file);
  const scale = Math.min(1, 1600 / bitmap.width);
  const canvas = document.createElement("canvas");
  canvas.width = Math.round(bitmap.width * scale);
  canvas.height = Math.round(bitmap.height * scale);
  canvas.getContext("2d")!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
  const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/webp", 0.85));
  if (!blob) throw new Error("Could not read that image.");
  return blob;
}

async function upload(row: HTMLElement, file: File) {
  uploads++;
  save.disabled = true;
  say("Uploading image…");
  try {
    const body = await prepare(file);
    const response = await fetch("/api/admin/upload", { method: "POST", headers: { "content-type": body.type }, body });
    if (response.status === 401) { location.href = "/admin/login"; return; }
    const data = await response.json();
    if (!response.ok) { say(data.error ?? "Upload failed.", "error"); return; }
    row.dataset.image = data.url;
    showImage(row);
    say("Image uploaded. Save to publish it.", "ok");
  } catch (error) {
    say(error instanceof Error ? error.message : "Upload failed.", "error");
  } finally {
    if (--uploads === 0) save.disabled = false;
  }
}

list.addEventListener("click", (event) => {
  const button = (event.target as HTMLElement).closest<HTMLElement>("[data-action]");
  const row = button?.closest<HTMLElement>(".project");
  if (!button || !row) return;
  const action = button.dataset.action;
  if (action === "up" && row.previousElementSibling) row.previousElementSibling.before(row);
  if (action === "down" && row.nextElementSibling) row.nextElementSibling.after(row);
  if (action === "remove" && confirm("Remove this project? It goes away when you save.")) row.remove();
  if (action === "clear-image") { row.dataset.image = ""; showImage(row); }
  refresh();
});
list.addEventListener("input", (event) => { if ((event.target as HTMLElement).matches("[data-p=name]")) refresh(); });
list.addEventListener("change", (event) => {
  const target = event.target as HTMLInputElement;
  if (!target.matches("[data-p=file]") || !target.files?.[0]) return;
  const file = target.files[0];
  target.value = "";
  upload(target.closest<HTMLElement>(".project")!, file);
});
document.querySelector("#add-project")!.addEventListener("click", () => {
  const row = addProject();
  input(row, "name").focus();
});

(JSON.parse(document.querySelector("#initial-projects")!.textContent || "[]") as ProjectData[]).forEach((p) => addProject(p));

form.addEventListener("submit", async (event) => {
  event.preventDefault();
  if (uploads > 0) return;
  const num = (v: string) => (v.trim() === "" ? NaN : Number(v));
  const body = {
    packs: [...document.querySelectorAll<HTMLElement>("[data-pack]")].map((pack) => ({
      id: pack.dataset.pack,
      name: field(pack, "name"),
      usd: num(field(pack, "usd")),
      robux: num(field(pack, "robux")),
      includes: field(pack, "includes").split("\n"),
    })),
    maintenance: { enabled: enabled.checked, message: message.value },
    announcement: { enabled: checked("#ann-enabled"), text: value("#ann-text"), linkLabel: value("#ann-link-label"), linkUrl: value("#ann-link-url") },
    contact: { label: value("#contact-label"), url: value("#contact-url") },
    copy: Object.fromEntries([...document.querySelectorAll<HTMLTextAreaElement>("[data-copy]")].map((el) => [el.dataset.copy, el.value])),
    projects: ([...list.children] as HTMLElement[]).map((row) => ({
      id: row.dataset.id,
      name: input(row, "name").value,
      service: input(row, "service").value,
      year: num(input(row, "year").value),
      summary: input(row, "summary").value,
      image: row.dataset.image ?? "",
    })),
  };
  save.disabled = true;
  say("Saving…");
  try {
    const response = await fetch("/api/admin/site", { method: "PUT", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    const data = await response.json();
    if (response.status === 401) { location.href = "/admin/login"; return; }
    if (!response.ok) { say((data.errors ?? [data.error ?? "Could not save."]).join(" "), "error"); return; }
    badge.dataset.on = String(data.maintenance.enabled);
    badge.textContent = data.maintenance.enabled ? "Site is down" : "Site is live";
    say(data.maintenance.enabled ? "Saved. The public site is in maintenance mode." : "Saved. The public site is live.", "ok");
  } catch {
    say("Could not reach the server. Try again.", "error");
  } finally {
    save.disabled = uploads > 0;
  }
});
</script>
</body>
</html>
