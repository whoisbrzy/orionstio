# Copy to .env for local development. Never commit .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The one Google account allowed into /admin
ADMIN_EMAIL=
# Long random string, for example: openssl rand -base64 32
SESSION_SECRET=
# Optional. Full site address with no trailing slash, e.g. https://orion.example.com
# Used to build the Google redirect address. Defaults to the address of the request.
SITE_URL=
# Set by Vercel when you add an Upstash Redis database. Leave empty locally to store data in .data/site.json
KV_REST_API_URL=
KV_REST_API_TOKEN=
