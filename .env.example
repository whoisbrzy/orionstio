# Copy to .env for local development. Never commit .env.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional. The one Discord user ID allowed into /admin. Defaults to the studio owner.
ADMIN_DISCORD_ID=
# Long random string, for example: openssl rand -base64 32
SESSION_SECRET=
# Optional. Full site address with no trailing slash, e.g. https://orion.example.com
# Used to build the Discord redirect address. Defaults to the address of the request.
SITE_URL=
# Supabase project (Settings > API). Leave empty locally to store data in .data/site.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
